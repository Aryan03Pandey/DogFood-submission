                        "role": {
                          "type": "string",
                          "enum": [
                            "SUPERADMIN",
                            "ORGANIZER",
                            "JUDGE",
                            "PARTICIPANT"
                          ]
                        },
                        "organization": {
                          "type": "string",
                          "nullable": true
                        },
                        "createdAt": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "name",
                        "role",
                        "organization",
                        "createdAt"
                      ]
                    },
                    "expiresAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "user",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "400": {
