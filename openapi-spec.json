                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
