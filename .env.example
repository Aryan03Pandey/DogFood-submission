DATABASE_URL=postgres://dogfood:dogfood@localhost:5432/dogfood
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=dogfood
S3_SECRET_KEY=dogfoodlocal
S3_BUCKET=dogfood-assets
S3_REGION=us-east-1
SEAWEEDFS_FILER_URL=http://localhost:8888
OFFLINE_MODE=true
NODE_ENV=development
SIGNING_KEY_PATH=./data/keys/ed25519.pem
PUBLIC_BASE_URL=http://localhost:3000

# Tier 4.5 webhooks — both off/empty by default.
# WEBHOOK_ALLOWED_HOSTS: comma-separated hostnames that skip the SSRF
# blocklist/IP checks (only those hosts; everything else still checked).
WEBHOOK_ALLOWED_HOSTS=
# WEBHOOK_ALLOW_PRIVATE_HOSTS: blanket bypass for every host, local testing only.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
